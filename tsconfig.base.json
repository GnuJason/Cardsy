{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@grandmagame/card-engine": ["./packages/card-engine/src/index.ts"],
      "@grandmagame/game-logic": ["./packages/game-logic/src/index.ts"],
      "@grandmagame/pixi-engine": ["./packages/pixi-engine/src/index.ts"],
      "@grandmagame/ui": ["./packages/ui/src/index.ts"],
      "@grandmagame/themes": ["./packages/themes/src/index.ts"],
      "@grandmagame/storage": ["./packages/storage/src/index.ts"]
    }
  }
}